<?xml version="1.0" encoding="utf-8"?>
<!-- 两种组件共用一个底部弹窗，只替换文字、截图和链接。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <!-- 引导标题由当前组件填充。 -->
    <TextView android:id="@+id/guide_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="20sp" android:accessibilityHeading="true" />
    <!-- 对应组件的简短介绍。 -->
    <TextView android:id="@+id/guide_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="15sp" />
    <!-- 对应小组件截图由宿主提供。 -->
    <ImageView android:id="@+id/widget_preview" android:layout_width="match_parent" android:layout_height="160dp" android:layout_marginTop="16dp" android:scaleType="fitCenter" />
    <!-- 添加按钮固定横向排列。 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal">
        <!-- 左按钮进入桌面添加页。 -->
        <Button android:id="@+id/add_desktop" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:text="@string/guide_add_desktop" />
        <!-- 右按钮进入负一屏添加页。 -->
        <Button android:id="@+id/add_assistant" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:minHeight="48dp" android:text="@string/guide_add_assistant" />
    </LinearLayout>
</LinearLayout>
