<?xml version="1.0" encoding="utf-8"?>
<!-- 仅 Debug 使用的验证面板。配置和测试时钟仅在内存中修改，清空状态是显式操作。 -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/debug_heading"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />
        <TextView
            android:id="@+id/help"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/debug_help"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />
        <!-- 自动引导云配开关，关闭不清空已经完成的行为。 -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/enable_pop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/enable_pop" />
        <!-- 演示高亮暗词 deeplink 可以实际进入普通资讯详情。 -->
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/highlight_to_news" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/highlight_to_news" />
        <TextView
            android:id="@+id/first_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/first_interval"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />
        <!-- 同类型第 1 次至第 2 次展示间隔，单位为固定 24 小时。 -->
        <EditText
            android:id="@+id/first_interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="@string/first_interval"
            android:inputType="number"
            android:importantForAutofill="no" />
        <TextView
            android:id="@+id/second_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/second_interval"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />
        <!-- 同类型第 2 次至第 3 次展示间隔，单位为固定 24 小时。 -->
        <EditText
            android:id="@+id/second_interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="@string/second_interval"
            android:inputType="number"
            android:importantForAutofill="no" />
        <!-- 校验两个非负整数后更新内存配置，触发控制器重算。 -->
        <Button
            android:id="@+id/apply_config"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/apply_config" />
        <!-- 显示注入测试时钟，便于验证自然日与固定时长的区别。 -->
        <TextView
            android:id="@+id/test_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/debug_heading"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />
        <!-- 将测试时钟前进 24 小时，不修改系统时间。 -->
        <Button
            android:id="@+id/advance_day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/advance_day" />
        <!-- 确认后清空测试行为与次数，同时重建控制器。 -->
        <Button
            android:id="@+id/reset_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/reset_state" />
        <!-- 直接打开本地 SP 原始键值与最近一次拒绝原因。 -->
        <Button
            android:id="@+id/show_records"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/guide_records_open" />
        <!-- 返回上一页面，页面恢复时由生命周期报告 visible。 -->
        <Button
            android:id="@+id/back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/back" />
    </LinearLayout>
</ScrollView>
