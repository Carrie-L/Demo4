<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/debug_heading"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />
        <TextView
            android:id="@+id/help"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/debug_help"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/enable_pop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/enable_pop" />
        <TextView
            android:id="@+id/first_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/first_interval"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />
        <EditText
            android:id="@+id/first_interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="@string/first_interval"
            android:inputType="number"
            android:importantForAutofill="no" />
        <TextView
            android:id="@+id/second_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/second_interval"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />
        <EditText
            android:id="@+id/second_interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="@string/second_interval"
            android:inputType="number"
            android:importantForAutofill="no" />
        <Button
            android:id="@+id/apply_config"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/apply_config" />
        <TextView
            android:id="@+id/test_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/debug_heading"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />
        <Button
            android:id="@+id/advance_day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/advance_day" />
        <Button
            android:id="@+id/reset_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/reset_state" />
        <Button
            android:id="@+id/back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/back" />
    </LinearLayout>
</ScrollView>
